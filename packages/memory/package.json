{
  "name": "@agentworks/memory",
  "version": "0.3.0-alpha.0",
  "description": "AgentWorks vault contract — tenant-isolated, file-backed memory wrapper used by agentos-d MCP memory.read / memory.write",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./file-store": {
      "import": "./dist/file-store.js",
      "types": "./dist/file-store.d.ts"
    },
    "./session-brief": {
      "import": "./dist/session-brief.js",
      "types": "./dist/session-brief.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agentworks",
    "memory",
    "vault",
    "metadata"
  ],
  "license": "UNLICENSED",
  "private": true
}
